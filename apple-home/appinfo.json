    "actions": [
      {
        "name": "get_state",
        "displayName": "Apple Home Control",
        "description": "Read current HomeKit state for one device. Each field reports fresh or unavailable; cached discovery values are not current readings. Use the structured result to answer the user.",
        "parameters": {
          "type": "object",
          "properties": {
            "instanceId": {
              "type": "string",
              "minLength": 1,
              "description": "Exact service ID from home/device. Use either instanceId or device."
            },
            "device": {
              "type": "string",
              "minLength": 1,
              "description": "Exact service or accessory name; qualify duplicate names with room, or use instanceId."
            },
            "room": {
              "type": "string",
              "minLength": 1,
              "description": "Exact room name or ID from home/room."
            },
            "home": {
              "type": "string",
              "minLength": 1,
              "description": "Optional name or ID of the connected home. Changing homes requires plugin settings."
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "description": "Alias for device. Exact names only."
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "targets": [
          "home/device"
        ],
        "destructive": false,
        "requiresConfirmation": false,
        "usesPermissions": [
          {
            "name": "AppleHome",
            "parameters": {}
          }
        ],
        "callerPermissions": [],
        "timeoutSec": 30
      },
      {
        "name": "turn_on",
        "displayName": "Apple Home Control",
        "description": "Turn on a light, switch, outlet, or fan. Read home/device first for exact names, service IDs, and writable capabilities. Only the home selected in settings is accessible. Never retry an unconfirmed write without reading state.",
        "parameters": {
          "type": "object",
          "properties": {
            "instanceId": {
              "type": "string",
              "minLength": 1,
              "description": "Exact service ID from home/device. Use either instanceId or device."
            },
            "device": {
              "type": "string",
              "minLength": 1,
              "description": "Exact service or accessory name; qualify duplicate names with room, or use instanceId."
            },
            "room": {
              "type": "string",
              "minLength": 1,
              "description": "Exact room name or ID from home/room."
            },
            "home": {
              "type": "string",
              "minLength": 1,
              "description": "Optional name or ID of the connected home. Changing homes requires plugin settings."
            },
            "device_type": {
              "type": "string",
              "enum": [
                "light",
                "switch",
                "outlet",
                "fan",
                "thermostat",
                "speaker",
                "television",
                "lock",
                "temperature_sensor",
                "humidity_sensor",
                "motion_sensor",
                "contact_sensor",
                "occupancy_sensor",
                "leak_sensor",
                "smoke_sensor",
                "light_sensor",
                "battery",
                "garage_door",
                "security_system",
                "window_covering",
                "carbon_monoxide_sensor",
                "carbon_dioxide_sensor"
              ],
              "description": "Optional service type; required for group control."
            },
            "all": {
              "type": "boolean",
              "description": "Set true only when the user requested every matching device in a room. Requires room and device_type; omit device and instanceId. Maximum 10 devices."
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "description": "Alias for device. Exact names only."
            },
            "type": {
              "type": "string",
              "description": "Alias for device_type."
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "targets": [
