{
  "name": "apple-notes-plugin",
  "version": "0.3.0",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepare:upstream": "node scripts/prepare-upstream.mjs",
    "build": "node scripts/build-runtime.mjs",
    "build:test-upstream": "node scripts/build-upstream-test.mjs",
    "test": "npm run prepare:upstream && node test/vendor-sync.mjs && npm run build && npm run build:test-upstream && node test/compare.mjs && node --test test/*.test.js"
  },
  "dependencies": {
    "pako": "3.0.1"
  },
  "devDependencies": {
    "@bufbuild/protobuf": "2.12.1",
    "esbuild": "0.25.9",
    "node-diff3": "3.2.1"
  }
}
