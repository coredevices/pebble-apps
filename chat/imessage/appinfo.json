  "plugin": {
    "uuid": "7f6296e7-4f00-4146-a710-3a52995e9ba6",
    "name": "iMessage",
    "description": "Sends a plain-text iMessage to one individual email address, phone number, or contact saved in the plugin settings.",
    "script": "plugin.js",
    "configPage": "config.html",
    "sources": [],
    "actions": [
      {
        "name": "send_message",
        "description": "Send a plain-text iMessage to one individual. A configured contact name such as Danny is accepted as the recipient. For ‘send Danny hey whats up over iMessage’, pass recipient ‘Danny’ and text ‘hey whats up’; ‘over iMessage’ selects this action and is not message text. Use only when the user explicitly asks to send an iMessage and supplies or clearly identifies the recipient.",
        "parameters": {
          "type": "object",
          "properties": {
            "recipient": {
              "type": "string",
              "description": "The recipient's configured contact name, iMessage email address, or E.164 phone number, such as Danny, person@example.com, or +14155550123. Pass a spoken contact name through unchanged so the plugin can resolve it."
            },
            "text": {
              "type": "string",
              "description": "The exact plain-text message to send."
            }
          },
          "required": ["recipient", "text"]
        },
        "targets": [],
        "destructive": false,
        "requiresConfirmation": false,
        "usesPermissions": [
          "Crypto",
          "JavaScriptWorker",
          {
            "name": "Internet",
            "parameters": {
              "origins": [
                "https://ani.sidestore.io",
                "https://gsa.apple.com",
                "https://setup.icloud.com",
                "https://raw.githubusercontent.com",
                "http://init-p01st.push.apple.com",
                "https://init.ess.apple.com",
                "https://apple.com",
                "https://*.apple.com"
              ]
            }
          },
