+#[cfg(feature = "port-oracle")]
+pub fn port_oracle_encode_raw(
+    command: u8,
+    fields: &[(u8, Vec<u8>)],
+) -> Result<Vec<u8>, PushError> {
+    let mut raw = APSRawMessage {
+        command,
+        length: 0,
+        body: fields
+            .iter()
+            .map(|(id, value)| APSRawField {
+                id: *id,
+                length: 0,
+                value: value.clone(),
+            })
+            .collect(),
+    };
+    for field in &mut raw.body {
+        field.update()?;
+    }
+    raw.update()?;
+    Ok(raw.to_bytes()?)
+}
