+#[cfg(feature = "port-oracle")]
+impl From<PortOraclePackedValue> for APSPackedValue {
+    fn from(value: PortOraclePackedValue) -> Self {
+        match value {
+            PortOraclePackedValue::Data(value) => Self::Data(value),
+            PortOraclePackedValue::String(value) => Self::String(value),
+            PortOraclePackedValue::Int(value) => Self::Int(value),
+            PortOraclePackedValue::Dict(value) => Self::Dict(
+                value.into_iter().map(APSPackedAttribute::from).collect()
+            ),
+            PortOraclePackedValue::Array(value) => Self::Array(
+                value.into_iter().map(APSPackedValue::from).collect()
+            ),
+            PortOraclePackedValue::Bool(value) => Self::Bool(value),
+        }
+    }
+}
