+#[cfg(feature = "port-oracle")]
+pub fn port_oracle_encode_packed(
+    messages: &[PortOraclePackedMessage],
+    value_cache_size: usize,
+) -> Result<Vec<Vec<u8>>, PushError> {
+    let mut encoder = APSPackedEncoder::new_with_cache_size(value_cache_size);
+    messages.iter().cloned().map(|message| {
+        let mut frame = Vec::new();
+        encoder.encode_message(message.into(), Cursor::new(&mut frame))?;
+        Ok(frame)
+    }).collect()
+}
+
+#[cfg(feature = "port-oracle")]
+pub fn port_oracle_decode_packed(
+    frames: &[Vec<u8>],
+    value_cache_size: usize,
+) -> Result<Vec<PortOraclePackedMessage>, PushError> {
+    let mut decoder = APSPackedDecoder::new_with_cache_size(value_cache_size);
+    frames.iter().map(|frame| {
+        decoder.decode_message(Cursor::new(frame)).map(PortOraclePackedMessage::from)
+    }).collect()
+}
