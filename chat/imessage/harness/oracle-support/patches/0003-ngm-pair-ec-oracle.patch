+
+#[cfg(feature = "port-oracle")]
+pub fn port_oracle_compose_ngm_pair_ec(
+    body: &[u8],
+    counter: u32,
+    padding: &[u8],
+    secret: &[u8],
+    sender_device: &[u8],
+    target_device: &[u8],
+    target_prekey: &[u8],
+    ephemeral: &[u8],
+    signature: &[u8],
+) -> Result<PortOracleNGMPairEc, PushError> {
+    if secret.len() != 32
+        || sender_device.len() != 32
+        || target_device.len() != 32
+        || target_prekey.len() != 32
+        || ephemeral.len() != 32
+        || signature.len() != 64
+    {
+        return Err(PushError::BadMsg);
+    }
+
+    let inner = idsp::InnerMessage {
+        message: body.to_vec(),
+        counter: Some(counter),
+        kt_gossip_data: vec![],
+        debug_info: vec![],
+    }.encode_to_vec();
+    let padding_len = inner.len().wrapping_neg() % 16;
+    if padding.len() != padding_len {
+        return Err(PushError::BadMsg);
+    }
+    let mut cleartext = inner.clone();
+    cleartext.extend_from_slice(padding);
+    cleartext.extend_from_slice(&(padding_len as u32).to_le_bytes());
+
+    let (key, iv) = derive_hkdf_key_iv(secret)?;
+    let mut ciphertext = cleartext.clone();
+    let mut cipher = ctr::Ctr64BE::<aes::Aes256>::new(&key.into(), &iv.into());
+    cipher.apply_keystream(&mut ciphertext);
+
+    let signature_data = [
+        secret.to_vec(),
+        target_prekey.to_vec(),
+        ephemeral.to_vec(),
+        target_device.to_vec(),
+        ciphertext.clone(),
+    ].concat();
+    let validator = [
+        sender_device[..2].to_vec(),
+        target_device[..2].to_vec(),
+        target_prekey[..2].to_vec(),
+        vec![0x0c],
+    ].concat();
+    let outer = idsp::OuterMessage {
+        payload: ciphertext.clone(),
+        key: ephemeral.to_vec(),
+        signature: signature.to_vec(),
+        validator: validator.clone(),
+    }.encode_to_vec();
+
+    Ok(PortOracleNGMPairEc {
+        outer, inner, cleartext, ciphertext, signature_data, validator,
+    })
+}
