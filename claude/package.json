{
  "name": "claude",
  "author": "Core Devices",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "pebble": {
    "displayName": "Claude",
    "uuid": "0d33014e-5d56-42ea-9665-3ebf182b4cfb",
    "sdkVersion": "3",
    "capabilities": [
      "web_sign_in"
    ],
    "usesPermissions": [
      {
        "name": "Internet",
        "parameters": {
          "domains": [
            "claude.ai"
          ]
        }
      }
    ],
    "plugin": {
      "description": "Send messages to your Claude conversations and Claude Code sessions. With no chat named, starts a new chat, or sends to the default chat chosen in settings. Supports chat nicknames. Sign in in settings.",
      "script": "src/plugin/index.js",
      "sources": [
        {
          "category": "agent",
          "items": [
            "chats"
          ],
          "properties": {
            "name": [
              "shortText"
            ],
            "title": [
              "shortText"
            ],
            "url": [
              "longText"
            ]
          },
          "supportsMultiple": true,
          "callerPermissions": [],
          "suggestedRefreshIntervalSec": 900
        },
        {
          "category": "agent",
          "items": [
            "configured"
          ],
          "properties": {
            "name": [
              "shortText"
            ],
            "configured": [
              "boolean",
              "shortText"
            ]
          },
          "supportsMultiple": false,
          "callerPermissions": [],
          "suggestedRefreshIntervalSec": 60
        }
      ],
      "actions": [
        {
          "name": "send_to_agent",
          "description": "Send a message to one of the user's Claude chats: a regular Claude conversation or a Claude Code session. chat_id is an instanceId from agent/chats, or a nickname; omit it to start a new chat, or to use the default chat when one is set in settings. Returns a receipt, not Claude's answer. Do not automatically retry an uncertain delivery or conflict.",
          "parameters": {
            "type": "object",
            "properties": {
              "message": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16000,
                "description": "What to tell Claude, without the \"tell Claude\" instruction itself."
              },
              "chat_id": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "The chat's instanceId from agent/chats, its nickname, or part of its title. Omit to start a new chat (or use the default chat, when one is set)."
              }
            },
            "required": [
              "message"
            ],
            "additionalProperties": false
          },
          "targets": [
            "agent/chats"
          ],
          "destructive": false,
          "requiresConfirmation": false,
          "callerPermissions": []
        }
      ]
    },
    "configPage": "src/config.html",
    "projectType": "plugin"
  }
}
