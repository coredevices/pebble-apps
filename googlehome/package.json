{
  "name": "googlehome-plugin",
  "version": "0.1.2",
  "description": "Google Home plugin source; builds pbw/plugin.js.",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "esbuild src/plugin.ts --bundle --minify --format=iife --platform=neutral --target=es2022 --outfile=pbw/plugin.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
