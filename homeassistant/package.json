      "actions": [
        {
          "name": "toggle",
          "description": "Turn a device, a room or the whole home on if it is off, or off if anything in it is on. Covers open and close.",
          "parameters": {
            "type": "object",
            "properties": {
              "item": {
                "type": "string",
                "enum": [
                  "home_lights",
                  "room_lights",
                  "light",
                  "device",
                  "automation"
                ],
                "description": "Which kind of thing instanceId names."
              },
              "instanceId": {
                "type": "string",
                "description": "Id from the matching home/* source: an entity id, an area id, or \"home\"."
              },
              "name": {
                "type": "string",
                "description": "Device name, exact preferred; otherwise case-insensitive substring. A trailing device kind is tolerated."
              },
              "room": {
                "type": "string",
                "description": "Room (Home Assistant area) name, case-insensitive."
              },
              "type": {
                "type": "string",
                "description": "Device type such as light, switch, outlet, fan, cover, speaker, tv, thermostat or lock, or all for every kind."
              }
            },
            "anyOf": [
              {
                "required": [
                  "instanceId"
                ]
              },
              {
                "required": [
                  "name"
                ]
              },
              {
                "required": [
                  "room"
                ]
              },
              {
                "required": [
                  "type"
                ]
              }
            ]
          },
