{
  "name": "ios-shortcuts",
  "author": "Core Devices",
  "version": "0.1.1",
  "pebble": {
    "displayName": "iOS Shortcuts",
    "uuid": "b4f616a3-727b-4e6e-9a6e-6cd13fc63d3f",
    "sdkVersion": "3",
    "plugin": {
      "description": "Connects Index and Pebble with Apple's Shortcuts app. Index can run allow-listed shortcuts with text or JSON input and display their textual output; Shortcuts automations can submit text to Index, control Pebble Quiet Time, or publish an event back to Index.",
      "script": "src/plugin/index.js",
      "sources": [
        {
          "category": "shortcuts",
          "items": [
            "shortcut"
          ],
          "properties": {
            "name": [
              "shortText",
              "longText"
            ],
            "shortcut_name": [
              "longText"
            ],
            "description": [
              "longText"
            ]
          },
          "supportsMultiple": true,
          "callerPermissions": [],
          "suggestedRefreshIntervalSec": 3600
        },
        {
          "category": "shortcuts",
          "items": [
            "input"
          ],
          "properties": {
            "name": [
              "shortText",
              "longText"
            ],
            "command": [
              "shortText"
            ],
            "input": [
              "longText"
            ],
            "result": [
              "longText"
            ],
            "status": [
              "shortText"
            ],
            "received_at": [
              "timestamp"
            ]
          },
          "supportsMultiple": true,
          "callerPermissions": [],
          "suggestedRefreshIntervalSec": 60
        }
      ],
      "actions": [
        {
          "name": "run_shortcut",
          "displayName": "iOS Shortcuts",
          "description": "Run one of the shortcuts allow-listed in this plugin's settings on the paired iPhone or iPad. Use the shortcut's configured label or exact Apple Shortcuts name. Pass either input for plain text or payload for structured JSON, never both. The shortcut's textual output is returned to Index and displayed in the action result.",
          "parameters": {
            "type": "object",
            "properties": {
              "shortcut": {
                "type": "string",
                "minLength": 1,
                "description": "Configured label or exact Apple Shortcuts name. Read shortcuts/shortcut first when the available names are unknown."
              },
              "input": {
                "type": "string",
                "description": "Optional plain-text Shortcut Input."
              },
              "payload": {
                "type": "object",
                "description": "Optional structured Shortcut Input; serialized as JSON text before launch."
              }
            },
            "required": [
              "shortcut"
            ],
            "additionalProperties": false
          },
          "destructive": false,
          "requiresConfirmation": false,
          "callerPermissions": []
        },
        {
          "name": "receive_input",
          "displayName": "Send to Index/Pebble",
          "description": "Internal entry point for CoreApp's trusted iOS AppIntent. Records a Shortcuts automation input after the host has submitted it to Index, changed Pebble Quiet Time, or accepted it as an event. Not exposed to Index or general plugin callers.",
          "parameters": {
            "type": "object",
            "properties": {
              "command": {
                "type": "string",
                "enum": [
                  "ask_index",
                  "quiet_time",
                  "event"
                ]
              },
              "text": {
                "type": "string"
              },
              "enabled": {
                "type": "boolean"
              },
              "result": {
                "type": "string"
              },
              "received_at_ms": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "command"
            ],
            "additionalProperties": false
          },
          "destructive": false,
          "requiresConfirmation": false,
          "callerPermissions": [
            {
              "name": "CoreAppAppIntent"
            }
          ]
        }
      ]
    },
    "configPage": "src/config.html",
    "projectType": "plugin",
    "usesPermissions": [
      "IOSShortcuts"
    ]
  }
}
