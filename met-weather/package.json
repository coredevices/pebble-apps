{
  "name": "met-weather",
  "author": "Pebble",
  "version": "1.0.4",
  "pebble": {
    "displayName": "MET Norway Weather",
    "uuid": "323dc117-55bd-455f-9ee4-4d0faba56ea1",
    "sdkVersion": "3",
    "usesPermissions": [
      "Location",
      {
        "name": "Internet",
        "parameters": {
          "domains": [
            "api.met.no"
          ]
        }
      }
    ],
    "plugin": {
      "description": "Weather for the user's weather locations (the phone's position for the current-location one), from the Norwegian Meteorological Institute (api.met.no), in their units: now, the hours of today and tomorrow, the week ahead and sunrise/sunset. Enough to be the watch's weather provider (Settings → Weather).",
      "script": "src/plugin/index.js",
      "sources": [
        {
          "category": "weather",
          "items": [
            "location"
          ],
          "properties": {
            "name": [
              "shortText"
            ],
            "temperature": [
              "shortText",
              "longText",
              "numericValue"
            ],
            "feels_like": [
              "shortText",
              "longText",
              "numericValue"
            ],
            "high": [
              "shortText",
              "longText",
              "numericValue"
            ],
            "low": [
              "shortText",
              "longText",
              "numericValue"
            ],
            "condition": [
              "shortText",
              "longText",
              "icon",
              "image"
            ],
            "condition_code": [
              "longText"
            ],
            "uv_index": [
              "numericValue",
              "shortText"
            ],
            "hourly_temperature": [
              "series.numericValue",
              "series.shortText"
            ],
            "hourly_condition": [
              "series.shortText",
              "series.icon",
              "series.image"
            ],
            "hourly_condition_code": [
              "series.longText"
            ],
            "precipitation": [
              "numericValue",
              "shortText"
            ],
            "humidity": [
              "numericValue",
              "shortText"
            ],
            "wind_speed": [
              "numericValue",
              "shortText"
            ],
            "wind_direction": [
              "numericValue"
            ],
            "utc_offset": [
              "numericValue"
            ],
            "sunrise": [
              "timestamp"
            ],
            "sunset": [
              "timestamp"
            ],
            "daily_high": [
              "series.numericValue",
              "series.shortText"
            ],
            "daily_low": [
              "series.numericValue",
              "series.shortText"
            ],
            "daily_condition": [
              "series.shortText",
              "series.longText",
              "series.icon",
              "series.image"
            ],
            "daily_condition_code": [
              "series.longText"
            ],
            "daily_precipitation": [
              "series.numericValue"
            ],
            "daily_sunrise": [
              "series.timestamp"
            ],
            "daily_sunset": [
              "series.timestamp"
            ]
          },
          "callerPermissions": [
            "Location"
          ],
          "suggestedRefreshIntervalSec": 1800
        }
      ]
    }
  }
}
