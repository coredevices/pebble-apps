{
  "name": "muse",
  "author": "Core Devices",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "test": "npm run build && node --test test/*.test.js"
  },
  "dependencies": {
    "@noble/ciphers": "1.3.0",
    "@noble/curves": "1.9.7",
    "@noble/hashes": "1.8.0",
    "buffer": "6.0.3",
    "protobufjs": "8.8.0"
  },
  "devDependencies": {
    "esbuild": "0.25.9"
  },
  "pebble": {
    "displayName": "Muse",
    "uuid": "b8346592-cd59-4b83-9185-87d94e0734b0",
    "sdkVersion": "3",
    "capabilities": [
      "web_sign_in"
    ],
    "usesPermissions": [
      {
        "name": "Internet",
        "parameters": {
          "domains": [
            "muse.ai",
            "hatch.metaaivm.com"
          ]
        }
      }
    ],
    "plugin": {
      "description": "Send messages to your Muse chats. With no chat named, sends to the chat chosen in settings (Main chat by default). Sign in and choose the destination in settings.",
      "script": "plugin.js",
      "sources": [
        {
          "category": "agent",
          "items": [
            "chats"
          ],
          "properties": {
            "name": [
              "shortText"
            ]
          },
          "supportsMultiple": true,
          "callerPermissions": [],
          "suggestedRefreshIntervalSec": 900
        },
        {
          "category": "agent",
          "items": [
            "configured"
          ],
          "properties": {
            "name": [
              "shortText"
            ],
            "configured": [
              "boolean",
              "shortText"
            ]
          },
          "supportsMultiple": false,
          "callerPermissions": [],
          "suggestedRefreshIntervalSec": 60
        }
      ],
      "actions": [
        {
          "name": "send_to_agent",
          "description": "Send a message to one of the user's Muse chats. chat_id is an instanceId from agent/chats or a chat name; omit it to use the chat selected in plugin settings (Main chat by default). Do not use unless the user explicitly addresses Muse or asks to send something to it, e.g. \"message Muse …\", \"send to Muse …\", \"tell Muse …\", \"ask Muse …\" or \"Muse, …\". Never use it for notes, reminders, or messages meant for anyone else. Returns a delivery receipt, not Muse’s answer. Do not automatically retry an uncertain delivery.",
          "parameters": {
            "type": "object",
            "properties": {
              "message": {
                "type": "string",
                "description": "The text to deliver to Muse, without the \"send to Muse\" instruction itself.",
                "minLength": 1,
                "maxLength": 16000
              },
              "chat_id": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "The chat's instanceId from agent/chats, or its name (\"Main chat\" for the main chat). Omit to use the chat selected in settings."
              }
            },
            "required": [
              "message"
            ],
            "additionalProperties": false
          },
          "targets": [
            "agent/chats"
          ],
          "destructive": false,
          "requiresConfirmation": false,
          "callerPermissions": []
        }
      ]
    },
    "configPage": "config.html",
    "projectType": "plugin"
  }
}
