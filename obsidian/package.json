{
  "name": "obsidian",
  "author": "Core Devices",
  "version": "0.2.0",
  "pebble": {
    "displayName": "Obsidian/Markdown Notes",
    "uuid": "8ee7164e-0afd-4a79-9a8a-d0bcf35570d8",
    "sdkVersion": "3",
    "plugin": {
      "description": "Creates separate Markdown notes or safely appends to a selected existing note in a user-selected folder, with Obsidian-compatible tasks and links.",
      "script": "src/plugin/index.js",
      "sources": [
        {
          "category": "notes",
          "items": [
            "destination"
          ],
          "properties": {
            "name": [
              "shortText"
            ],
            "configured": [
              "boolean",
              "shortText"
            ],
            "path": [
              "shortText",
              "longText"
            ]
          },
          "supportsMultiple": false,
          "callerPermissions": [],
          "suggestedRefreshIntervalSec": 60
        },
        {
          "category": "notes",
          "items": [
            "configured"
          ],
          "properties": {
            "name": [
              "shortText"
            ],
            "configured": [
              "boolean",
              "shortText"
            ]
          },
          "supportsMultiple": false,
          "callerPermissions": [],
          "suggestedRefreshIntervalSec": 60
        },
        {
          "category": "reminders",
          "items": [
            "list"
          ],
          "properties": {
            "name": [
              "shortText"
            ],
            "destination": [
              "shortText"
            ],
            "path": [
              "longText"
            ]
          },
          "supportsMultiple": false,
          "callerPermissions": [],
          "suggestedRefreshIntervalSec": 60
        },
        {
          "category": "reminders",
          "items": [
            "configured"
          ],
          "properties": {
            "name": [
              "shortText"
            ],
            "configured": [
              "boolean",
              "shortText"
            ]
          },
          "supportsMultiple": false,
          "callerPermissions": [],
          "suggestedRefreshIntervalSec": 60
        }
      ],
      "actions": [
        {
          "name": "create_note",
          "description": "Save a note as a Markdown file in the configured folder: a new timestamped note, or a block appended to the selected existing note. Use only when the user explicitly asks to save or send a note to Obsidian/Markdown. Optional location metadata is included only when the user supplied it.",
          "parameters": {
            "type": "object",
            "properties": {
              "instanceId": {
                "type": "string",
                "enum": [
                  "markdown-notes"
                ],
                "description": "Optional destination id from the notes/destination source."
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "description": "The complete note text, preferably the user's exact words. In create mode the first line becomes the title."
              },
              "location": {
                "type": "object",
                "properties": {
                  "latitude": {
                    "type": "number",
                    "minimum": -90,
                    "maximum": 90
                  },
                  "longitude": {
                    "type": "number",
                    "minimum": -180,
                    "maximum": 180
                  },
                  "label": {
                    "type": "string"
                  }
                },
                "required": [
                  "latitude",
                  "longitude"
                ],
                "additionalProperties": false,
                "description": "Optional place to record with the note."
              }
            },
            "required": [
              "text"
            ],
            "additionalProperties": false
          },
          "targets": [
            "notes/destination"
          ],
          "destructive": false,
          "requiresConfirmation": false,
          "callerPermissions": []
        },
        {
          "name": "create_reminder",
          "description": "Append an Obsidian Tasks-compatible checklist item to the configured reminder file. Use only when the user explicitly asks for a reminder or task in Obsidian/Markdown. due_iso is an absolute ISO-8601 instant and timezone is the user's IANA time zone.",
          "parameters": {
            "type": "object",
            "properties": {
              "instanceId": {
                "type": "string",
                "enum": [
                  "markdown-reminders"
                ],
                "description": "Optional destination id from the reminders/list source."
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "description": "Reminder title."
              },
              "due_iso": {
                "type": "string",
                "format": "date-time",
                "description": "Optional absolute due instant in ISO-8601 format."
              },
              "timezone": {
                "type": "string",
                "description": "IANA time zone used to write the due date and time; defaults to the phone's zone."
              },
              "notify_before_ms": {
                "type": "integer",
                "minimum": 0,
                "description": "Optional notification lead time in milliseconds, written as whole minutes."
              },
              "location": {
                "type": "object",
                "properties": {
                  "latitude": {
                    "type": "number",
                    "minimum": -90,
                    "maximum": 90
                  },
                  "longitude": {
                    "type": "number",
                    "minimum": -180,
                    "maximum": 180
                  },
                  "label": {
                    "type": "string"
                  }
                },
                "required": [
                  "latitude",
                  "longitude"
                ],
                "additionalProperties": false,
                "description": "Optional place to record with the reminder."
              }
            },
            "required": [
              "title"
            ],
            "additionalProperties": false
          },
          "targets": [
            "reminders/list"
          ],
          "destructive": false,
          "requiresConfirmation": false,
          "callerPermissions": []
        }
      ]
    },
    "configPage": "src/config.html",
    "projectType": "plugin",
    "usesPermissions": [
      "ReadFiles",
      "WriteFiles"
    ]
  }
}
