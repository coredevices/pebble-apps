{
  "name": "remember-the-milk",
  "author": "Pebble",
  "version": "1.0.2",
  "scripts": {
    "test": "node --test test/*.test.cjs"
  },
  "pebble": {
    "displayName": "Remember The Milk",
    "uuid": "6c56bc9a-0571-43ec-aed0-3162a0cdbd6b",
    "sdkVersion": "3",
    "usesPermissions": [
      {
        "name": "Internet",
        "parameters": {
          "domains": [
            "api.rememberthemilk.com"
          ]
        }
      }
    ],
    "plugin": {
      "description": "Creates Remember The Milk tasks as reminders and exposes the user's lists as reminder destinations.",
      "script": "src/plugin/index.js",
      "sources": [
        {
          "category": "reminders",
          "items": [
            "list"
          ],
          "properties": {
            "name": [
              "shortText"
            ],
            "destination": [
              "shortText"
            ],
            "url": [
              "longText"
            ]
          },
          "supportsMultiple": true,
          "callerPermissions": [],
          "suggestedRefreshIntervalSec": 900
        },
        {
          "category": "reminders",
          "items": [
            "configured"
          ],
          "properties": {
            "name": [
              "shortText"
            ],
            "configured": [
              "boolean",
              "shortText"
            ]
          },
          "supportsMultiple": false,
          "callerPermissions": [],
          "suggestedRefreshIntervalSec": 60
        }
      ],
      "actions": [
        {
          "name": "create_reminder",
          "description": "Create a Remember The Milk task. Use instanceId from reminders/list to choose a list; omit it for Inbox. due_iso is an absolute ISO-8601 instant and timezone its IANA time-zone context. Remember The Milk sends reminders by the user's account reminder settings, so notify_before_ms is accepted but not stored.",
          "parameters": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "description": "Reminder title."
              },
              "due_iso": {
                "type": "string",
                "format": "date-time",
                "description": "Optional absolute due instant in ISO-8601 format."
              },
              "timezone": {
                "type": "string",
                "minLength": 1,
                "description": "IANA time-zone context. Required whenever due_iso is supplied."
              },
              "notify_before_ms": {
                "type": "integer",
                "minimum": 0,
                "description": "Optional notification lead time in milliseconds. Remember The Milk uses the account's reminder settings instead."
              },
              "instanceId": {
                "type": "string",
                "minLength": 1,
                "description": "Optional Remember The Milk list ID from reminders/list. Omit for Inbox."
              }
            },
            "required": [
              "title"
            ],
            "allOf": [
              {
                "if": {
                  "required": [
                    "due_iso"
                  ]
                },
                "then": {
                  "required": [
                    "timezone"
                  ]
                }
              }
            ],
            "additionalProperties": false
          },
          "targets": [
            "reminders/list"
          ],
          "destructive": false,
          "requiresConfirmation": false,
          "callerPermissions": []
        }
      ]
    },
    "configPage": "src/config.html",
    "projectType": "plugin"
  }
}
