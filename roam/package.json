{
  "name": "roam",
  "author": "Core Devices",
  "version": "0.1.3",
  "scripts": {
    "test": "node --test test/*.test.cjs"
  },
  "pebble": {
    "displayName": "Roam Research",
    "uuid": "3b7c7b02-bea8-4c7e-9bb8-d83afe744b77",
    "sdkVersion": "3",
    "usesPermissions": [
      {
        "name": "Internet",
        "parameters": {
          "domains": [
            "append-api.roamresearch.com"
          ]
        }
      }
    ],
    "plugin": {
      "description": "Captures notes to today's Roam daily note using an append-only graph token.",
      "script": "src/plugin/index.js",
      "sources": [
        {
          "category": "notes",
          "items": [
            "destination"
          ],
          "properties": {
            "name": [
              "shortText"
            ],
            "configured": [
              "boolean",
              "shortText"
            ],
            "location": [
              "shortText",
              "longText"
            ],
            "url": [
              "longText"
            ]
          },
          "supportsMultiple": false,
          "callerPermissions": [],
          "suggestedRefreshIntervalSec": 60
        }
      ],
      "actions": [
        {
          "name": "create_note",
          "description": "Capture plain text to today's daily note in the configured Roam graph. Use only when the user explicitly asks to save or send a note to Roam Research.",
          "parameters": {
            "type": "object",
            "properties": {
              "instanceId": {
                "type": "string",
                "enum": [
                  "roam"
                ],
                "description": "Optional destination id from the notes/destination source."
              },
              "text": {
                "type": "string",
                "description": "The complete plain text to capture, preferably using the user's exact words."
              }
            },
            "required": [
              "text"
            ]
          },
          "targets": [
            "notes/destination"
          ],
          "destructive": false,
          "requiresConfirmation": false,
          "callerPermissions": []
        }
      ]
    },
    "configPage": "src/config.html",
    "projectType": "plugin"
  }
}
