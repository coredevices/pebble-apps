{
  "name": "whatsplaying",
  "author": "Core Devices LLC",
  "version": "1.2.1",
  "keywords": ["pebble-app"],
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "test": "node --test test/*.test.cjs"
  },
  "pebble": {
    "displayName": "What's Playing",
    "uuid": "4ee4fb46-4764-4271-87d5-8d0169dbd889",
    "sdkVersion": "3",
    "manifestVersion": 2,
    "enableMultiJS": true,
    "targetPlatforms": [
      "emery",
      "flint",
      "gabbro"
    ],
    "watchapp": {
      "watchface": false
    },
    "capabilities": ["microphone"],
    "usesPermissions": [
      {
        "name": "WatchMicrophone",
        "reason": "To hear the song playing near your watch",
        "required": true
      },
      {
        "name": "Internet",
        "parameters": {
          "domains": [
            "sirensong.cluster.repebble.com"
          ]
        },
        "reason": "To identify the song",
        "required": true
      }
    ],
    "messageKeys": [
      "CMD",
      "SECONDS",
      "TITLE",
      "ARTIST",
      "ALBUM",
      "INDEX",
      "TOTAL",
      "ERROR"
    ],
    "resources": {
      "media": []
    },
    "plugin": {
      "description": "The songs What's Playing identified on the watch, newest first. To identify a song, open the What's Playing watchapp (Watch State's launch_app): opened from the phone it starts listening right away, and the match shows on the watch and here.",
      "script": "src/plugin/index.js",
      "sources": [
        {
          "category": "music",
          "items": ["identified"],
          "properties": {
            "title": ["longText"],
            "artist": ["longText"],
            "album": ["longText"],
            "identified": ["timestamp"],
            "url": ["longText"]
          },
          "supportsMultiple": true,
          "callerPermissions": [],
          "suggestedRefreshIntervalSec": 300
        }
      ],
      "actions": []
    }
  }
}
